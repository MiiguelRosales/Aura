rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /configuracion/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /usuarios/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.guardianVinculadoId == request.auth.uid ||
        resource.data.exploradorVinculadoId == request.auth.uid
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianVinculadoId', 'exploradorVinculadoId', 'codigoVinculado', 'vinculadoEn']))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /vinculos/{codigo} {
      allow read, write: if request.auth != null;
    }

    match /ubicaciones_explorador/{exploradorId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /mensajes/{guardianId}/historial/{messageId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.uid == guardianId;
    }
  }
}