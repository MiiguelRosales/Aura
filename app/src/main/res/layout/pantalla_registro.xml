<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_registro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_dark"
    tools:context=".pantalla_registro">

    <ImageView
        android:id="@+id/ivFondoGif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="centerCrop"
        tools:src="@drawable/pantalla_registro" />

    <TextView
        android:id="@+id/tvTituloRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/caveat_brush"
        android:shadowColor="@color/aura_card_stroke"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        android:text="REGISTRO"
        android:textAlignment="center"
        android:textColor="@color/aura_text_primary"
        android:textSize="70sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrar"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="107dp"
        android:fontFamily="@font/caveat_brush"
        android:text="REGISTRAR"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:backgroundTint="@color/aura_btn_fill"
        app:cornerRadius="28dp"
        app:strokeColor="@color/aura_btn_stroke"
        app:strokeWidth="1dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewRegistro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/btnRegistrar"
        android:layout_below="@id/tvTituloRegistro"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/aura_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/aura_card_stroke_subtle"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="30dp">

                <EditText
                    android:id="@+id/etNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Nombre de usuario"
                    android:inputType="textPersonName"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Fecha de nacimiento"
                    android:inputType="date"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Correo"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etCelular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Celular"
                    android:inputType="phone"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="@color/aura_input_underline"
                    android:fontFamily="@font/caveat_brush"
                    android:hint="Confirmar contraseña"
                    android:inputType="textPassword"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="24sp" />

            </LinearLayout>
        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/imageButtonRegistroIzquierda"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/flechaizquierda" />

</RelativeLayout>