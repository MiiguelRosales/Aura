<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_registro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".pantalla_registro">

    <ImageView
        android:id="@+id/ivFondoGif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.08"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@drawable/pantalla_registro" />

    <View
        android:id="@+id/blobTopRegistro"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-44dp"
        android:background="@drawable/bg_login_blob_top" />

    <View
        android:id="@+id/blobBottomRegistro"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-84dp"
        android:layout_marginBottom="-68dp"
        android:background="@drawable/bg_login_blob_bottom" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/login_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/login_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvSubtituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="REGISTRO"
                android:textColor="@color/aura_text_hint"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/cardViewRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Tipo de usuario"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTipoUsuario"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:boxBackgroundColor="@color/login_dropdown_field_bg"
                app:boxStrokeColor="@color/login_input_stroke"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/aura_text_hint"
                app:simpleItemSelectedColor="@android:color/transparent"
                app:simpleItemSelectedRippleColor="@android:color/transparent">

                <AutoCompleteTextView
                    android:id="@+id/actvTipoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:popupBackground="@drawable/bg_dropdown_blue"
                    android:dropDownSelector="@android:color/transparent"
                    android:fontFamily="sans-serif-condensed"
                    android:inputType="none"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/login_link"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvInfoTipoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_info_tipo_usuario"
                android:fontFamily="sans-serif-condensed"
                android:padding="8dp"
                android:text=""
                android:textColor="@color/login_link"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Nombre de usuario"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:backgroundTint="@color/login_input_stroke"
                android:fontFamily="sans-serif-condensed"
                android:hint="Ejemplo: MiguelR"
                android:inputType="textPersonName"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Fecha de nacimiento"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/login_input_stroke"
                    android:fontFamily="sans-serif-condensed"
                    android:hint="DD"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="center"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etMes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:backgroundTint="@color/login_input_stroke"
                    android:fontFamily="sans-serif-condensed"
                    android:hint="MM"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="center"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etAnio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.35"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/login_input_stroke"
                    android:fontFamily="sans-serif-condensed"
                    android:hint="AAAA"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textAlignment="center"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Correo electrónico"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCorreoLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/login_input_stroke"
                    android:fontFamily="sans-serif-condensed"
                    android:hint="usuario"
                    android:inputType="textNoSuggestions"
                    android:maxLength="25"
                    android:textColor="@color/aura_text_primary"
                    android:textColorHint="@color/aura_text_hint"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDominio"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="dominio"
                    app:boxBackgroundColor="@color/login_dropdown_field_bg"
                    app:boxStrokeColor="@color/login_input_stroke"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/aura_text_hint"
                    app:simpleItemSelectedColor="@android:color/transparent"
                    app:simpleItemSelectedRippleColor="@android:color/transparent">

                    <AutoCompleteTextView
                        android:id="@+id/actvDominio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:popupBackground="@drawable/bg_dropdown_blue"
                        android:dropDownSelector="@android:color/transparent"
                        android:fontFamily="sans-serif-condensed"
                        android:inputType="none"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/aura_text_primary"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Celular"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:backgroundTint="@color/login_input_stroke"
                android:fontFamily="sans-serif-condensed"
                android:hint="10 dígitos"
                android:inputType="phone"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Contraseña"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:backgroundTint="@color/login_input_stroke"
                android:fontFamily="sans-serif-condensed"
                android:hint="Mínimo 8 caracteres"
                android:inputType="textPassword"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Confirmar contraseña"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:backgroundTint="@color/login_input_stroke"
                android:fontFamily="sans-serif-condensed"
                android:hint="Repite la misma contraseña"
                android:inputType="textPassword"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="14sp" />

                </LinearLayout>
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"
                android:text="REGISTRAR"
                android:textColor="@color/login_btn_text"
                android:textSize="14sp"
                app:backgroundTint="@color/login_btn_bg"
                app:cornerRadius="24dp"
                app:strokeColor="@color/login_btn_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>




