<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pantalla_inicio">

    <ImageView
        android:id="@+id/ivFondoGif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/pantalla_vincular" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/aura_overlay" />

    <!-- TOGGLE SOL / LUNA - esquina superior derecha -->
    <FrameLayout
        android:id="@+id/layoutThemeToggle"
        android:layout_width="64dp"
        android:layout_height="34dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/toggle_track_day"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivThumbToggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_sun"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <TextSwitcher
        android:id="@+id/textSwitcherFrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="86dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textSwitcherFrase"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="50dp"
        app:cardBackgroundColor="@color/aura_card_bg_trans"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/aura_card_stroke_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="324dp"
            android:orientation="vertical"
            android:padding="50dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInicio"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="INICIO"
                android:textColor="@color/white"
                android:fontFamily="@font/caveat_brush"
                android:textSize="28sp"
                app:backgroundTint="@color/aura_btn_fill"
                app:cornerRadius="12dp"
                app:strokeColor="@color/aura_btn_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="REGISTRATE"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="@font/caveat_brush"
                app:backgroundTint="@color/aura_btn_fill"
                app:cornerRadius="12dp"
                app:strokeColor="@color/aura_btn_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVincular"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="VINCULA"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:fontFamily="@font/caveat_brush"
                app:backgroundTint="@color/aura_btn_fill"
                app:cornerRadius="12dp"
                app:strokeColor="@color/aura_btn_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>