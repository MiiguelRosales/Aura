<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_juegos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".PantallaJuegos">

    <!-- FONDOS Y BLOBS -->
    <View
        android:id="@+id/blobTopJuegos"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-44dp"
        android:background="@drawable/bg_login_blob_top" />

    <View
        android:id="@+id/blobBottomJuegos"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-84dp"
        android:layout_marginBottom="-68dp"
        android:background="@drawable/bg_login_blob_bottom" />

    <!-- SECCIÓN SUPERIOR: Contador -->
    <LinearLayout
        android:id="@+id/layoutTopJuegos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContadorListo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Tiempo para confirmar: 02:00"
            android:textColor="@color/aura_subtitle_color"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR (3 Botones) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/login_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/login_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <!-- Tab Explorador (activa) -->
            <LinearLayout
                android:id="@+id/navPaginaExplorador"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Explorador"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab Perfil (inactiva) -->
            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.4">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Perfil"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tab Ajustes (inactiva) -->
            <LinearLayout
                android:id="@+id/navConfiguraciones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.4">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Ajustes"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTÓN LISTO -->
    <com.google.android.material.button.MaterialButton


        android:id="@+id/btnAccionJuegos"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_above="@id/cardBottomNav"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-condensed"
        android:enabled="false"
        android:clickable="false"
        android:alpha="0.5"
        android:text="Listo"
        android:textColor="@color/login_btn_text"
        android:textSize="14sp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:backgroundTint="@color/login_btn_bg"
        app:cornerRadius="28dp"
        app:strokeColor="@color/login_btn_stroke"
        app:strokeWidth="1dp" />

    <!-- PANEL CENTRAL: Grilla de Juegos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewJuegos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/btnAccionJuegos"
        android:layout_below="@id/layoutTopJuegos"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/login_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/login_card_stroke"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:fadeScrollbars="false">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego3"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego4"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego5"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego6"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego7"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego8"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/login_dropdown_field_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/login_card_stroke"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>




