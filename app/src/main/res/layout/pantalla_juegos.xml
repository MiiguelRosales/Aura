<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_juegos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".PantallaJuegos">

    <!-- FONDOS Y BLOBS -->
    <View
        android:id="@+id/blobTopJuegos"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-44dp"
        android:background="@drawable/bg_login_blob_top" />

    <View
        android:id="@+id/blobBottomJuegos"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="-84dp"
        android:layout_marginBottom="-68dp"
        android:background="@drawable/bg_login_blob_bottom" />

    <!-- SECCIÓN SUPERIOR: Contador -->
    <LinearLayout
        android:id="@+id/layoutTopJuegos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Tiempo restante"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tvContadorListo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="#00E676"
            android:textSize="44sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textAlignment="center"
            android:letterSpacing="0.05"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR (3 Botones) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/login_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/login_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <!-- Tab Explorador (activa) -->
            <LinearLayout
                android:id="@+id/navPaginaExplorador"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_nav_active">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Explorador"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.4">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvChatBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="-4dp"
                        android:background="@drawable/bg_chat_badge"
                        android:gravity="center"
                        android:minWidth="18dp"
                        android:minHeight="18dp"
                        android:paddingLeft="4dp"
                        android:paddingTop="0dp"
                        android:paddingRight="4dp"
                        android:paddingBottom="0dp"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Chat"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tab Perfil (inactiva) -->
            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.4">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Perfil"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tab Ajustes (inactiva) -->
            <LinearLayout
                android:id="@+id/navConfiguraciones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.4">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Ajustes"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTÓN LISTO -->
    <com.google.android.material.button.MaterialButton


        android:id="@+id/btnAccionJuegos"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_below="@id/layoutTopJuegos"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-condensed"
        android:enabled="false"
        android:clickable="false"
        android:alpha="0.5"
        android:text="Listo"
        android:textColor="@color/login_btn_text"
        android:textSize="14sp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:backgroundTint="@color/login_btn_bg"
        app:cornerRadius="28dp"
        app:strokeColor="@color/login_btn_stroke"
        app:strokeWidth="1dp" />

    <!-- PANEL CENTRAL: Grilla de Juegos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewJuegos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layoutNavegacionPaginacion"
        android:layout_below="@id/btnAccionJuegos"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/login_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/login_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/scrollViewJuegos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <GridLayout
                    android:id="@+id/gridPagina1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:columnOrderPreserved="false">

                </GridLayout>

                <GridLayout
                    android:id="@+id/gridPagina2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:columnOrderPreserved="false"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- SIMULADOR DE JUEGO (Oculto por defecto) -->
        <LinearLayout
            android:id="@+id/layoutSimuladorJuego"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutJuegoTresEnRaya"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Turno de X"
                        android:textColor="@color/aura_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:id="@+id/tableroGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignMargins"
                        android:columnCount="3"
                        android:rowCount="3"
                        android:useDefaultMargins="true">

                        <Button
                            android:id="@+id/btn00"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn01"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn02"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn10"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn11"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn12"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn20"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn21"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn22"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </GridLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutJuegoPPT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textoPPT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Elige piedra, papel o tijera"
                        android:textColor="@color/aura_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPiedra"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Piedra"
                            android:textSize="14sp"
                            app:backgroundTint="#607D8B"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPapel"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:text="Papel"
                            android:textSize="14sp"
                            app:backgroundTint="#3F51B5"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTijera"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Tijera"
                            android:textSize="14sp"
                            app:backgroundTint="#E91E63"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEleccionPPT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="IA aún no ha jugado"
                        android:textColor="@color/aura_text_hint"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvResultadoPPT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/aura_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutJuegoNumero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textoNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Adivina el número"
                        android:textColor="@color/aura_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNivelNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Nivel 1: 1 - 10"
                        android:textColor="@color/aura_text_hint"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/edtNumero"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="@color/login_dropdown_field_bg"
                        android:hint="Ingresa un número"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="@color/aura_text_primary"
                        android:textColorHint="@color/aura_text_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdivinar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="Adivinar"
                        android:textSize="16sp"
                        app:backgroundTint="#2196F3"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/tvPistaNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textColor="@color/aura_text_hint"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvResultadoNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/aura_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimularGanar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Reiniciar juego"
                android:textSize="16sp"
                app:backgroundTint="#00E676"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimularSalir"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="Volver a juegos"
                android:textSize="16sp"
                app:backgroundTint="#F44336"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

        <!-- Botones de paginación fijos bajo la tarjeta principal (siempre en la misma posición) -->
        <LinearLayout
            android:id="@+id/layoutNavegacionPaginacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_above="@id/cardBottomNav"
            android:layout_marginBottom="50dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaginaAnterior"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:minWidth="120dp"
                android:maxWidth="140dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:enabled="false"
                android:text="Anterior"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:icon="@drawable/flechaizquierda"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:backgroundTint="#8AB8F8"
                app:cornerRadius="28dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaginaSiguiente"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="25dp"
                android:minWidth="120dp"
                android:maxWidth="140dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Siguiente"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:icon="@drawable/flechaderecha"
                app:iconTint="@color/white"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:backgroundTint="#8AB8F8"
                app:cornerRadius="28dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </RelativeLayout>




