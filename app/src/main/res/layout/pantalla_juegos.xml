<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_juegos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_dark"
    tools:context=".PantallaJuegos">

    <ImageView
        android:id="@+id/ivFondoJuegos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="centerCrop"
        tools:src="@drawable/registro" />

    <ImageButton
        android:id="@+id/imageButtonRegresar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/flechaizquierda"
        android:contentDescription="Regresar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfiguracionJuegos"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="20dp"
        android:padding="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/aura_btn_fill"
        app:cornerRadius="32dp"
        app:icon="@drawable/configuracion"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="35dp"
        app:iconTint="@color/white"
        app:strokeColor="@color/aura_btn_stroke"
        app:strokeWidth="1dp"
        android:contentDescription="Configuración" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccionJuegos"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="36dp"
        android:fontFamily="@font/caveat_brush"
        android:text="JUGAR"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:backgroundTint="@color/aura_btn_fill"
        app:cornerRadius="28dp"
        app:strokeColor="@color/aura_btn_stroke"
        app:strokeWidth="1dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewJuegos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/btnAccionJuegos"
        android:layout_below="@id/btnConfiguracionJuegos"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/aura_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/aura_card_stroke_subtle"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:fadeScrollbars="false">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego3"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego4"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego5"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego6"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego7"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardJuego8"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="@color/aura_mini_card_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/aura_card_stroke_subtle"
                    app:strokeWidth="1dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/mesa" />
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>