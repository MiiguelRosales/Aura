<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon_dark"
    tools:context=".pantalla_login">

    <ImageView
        android:id="@+id/ivFondoGifLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/caveat_brush"
        android:shadowColor="@color/aura_card_stroke"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="18"
        android:text="LOGIN"
        android:textAlignment="center"
        android:textColor="@color/aura_text_primary"
        android:textSize="70sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="30dp"
        app:cardBackgroundColor="@color/aura_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/aura_card_stroke_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTipoUsuarioLogin"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Ingresar como"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/aura_input_underline"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/aura_text_hint">

                <AutoCompleteTextView
                    android:id="@+id/actvTipoUsuarioLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caveat_brush"
                    android:inputType="none"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="22sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <EditText
                android:id="@+id/etCorreoLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/aura_input_underline"
                android:fontFamily="@font/caveat_brush"
                android:hint="Correo"
                android:inputType="textEmailAddress"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/etContrasenaLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:backgroundTint="@color/aura_input_underline"
                android:fontFamily="@font/caveat_brush"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColor="@color/aura_text_primary"
                android:textColorHint="@color/aura_text_hint"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvDatosDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/caveat_brush"
                android:gravity="center"
                android:text=""
                android:textColor="@color/aura_subtitle_color"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbGuardarInicioSesion"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="@color/aura_btn_fill" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caveat_brush"
                    android:text="Guardar inicio de sesión"
                    android:textColor="@color/aura_text_hint"
                    android:textSize="16sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fontFamily="@font/caveat_brush"
                android:text="INICIAR SESIÓN"
                android:textColor="@color/white"
                android:textSize="28sp"
                app:backgroundTint="@color/aura_btn_fill"
                app:cornerRadius="28dp"
                app:strokeColor="@color/aura_btn_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/imageButtonLoginIzquierda"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/flechaizquierda" />

</RelativeLayout>