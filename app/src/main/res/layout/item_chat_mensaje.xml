<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvSeparadorFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_inner_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:textColor="@color/aura_text_hint"
        android:textSize="11sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="26 de abril de 2026"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/containerRecibido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:paddingEnd="56dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAvatarRecibido"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chat_avatar"
            android:gravity="center"
            android:textColor="@color/login_btn_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreRecibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/login_link"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMensajeRecibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="@color/login_dropdown_field_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/login_card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvMensajeRecibido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/ivImagenRecibida"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:adjustViewBounds="true"
                android:background="@drawable/card_inner_bg"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvArchivoRecibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/login_link"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHoraRecibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/aura_text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerEnviado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMensajeEnviado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            app:cardBackgroundColor="@color/login_btn_bg"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/login_btn_stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvMensajeEnviado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/login_btn_text"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/ivImagenEnviada"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:background="@drawable/card_inner_bg"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvArchivoEnviado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/login_link"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHoraEnviado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/aura_text_hint"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>